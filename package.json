{
  "name": "agent-desk",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Codex-style desktop for agents running on DeepSeek Harness (ChatGPT subscription + Claude API key)",
  "license": "MIT",
  "author": "Kansoku111",
  "homepage": "https://github.com/Kansoku111/agent-desk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kansoku111/agent-desk.git"
  },
  "bugs": {
    "url": "https://github.com/Kansoku111/agent-desk/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "desktop",
    "chatgpt",
    "claude",
    "deepseek",
    "dsh"
  ],
  "bin": {
    "agent-desk": "server/index.js"
  },
  "scripts": {
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node server/index.js",
    "serve": "node server/index.js --no-open",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "@openai/codex": "0.165.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "chrome-devtools-mcp": "1.10.1",
    "jose": "6.2.12",
    "node-pty": "^1.2.0-beta.15",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.4",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
